{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "esModuleInterop": true,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": ["server/**/*", "shared/**/*"]
}
